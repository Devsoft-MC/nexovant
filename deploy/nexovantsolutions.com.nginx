# Install as /etc/nginx/sites-available/nexovantsolutions.com and enable it.
# Issue the apex + www certificate with Certbot before enabling the TLS block.

server {
    listen 80;
    listen [::]:80;
    server_name nexovantsolutions.com www.nexovantsolutions.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name nexovantsolutions.com www.nexovantsolutions.com;

    ssl_certificate /etc/letsencrypt/live/nexovantsolutions.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nexovantsolutions.com/privkey.pem;

    root /var/www/nexovantsolutions/current;
    index index.html;

    location = /mail {
        return 301 https://nexovantsolutions.com/mail/;
    }

    location ^~ /mail/ {
        allow 10.77.0.1;
        deny all;

        auth_basic "Nexovant Mail Admin";
        auth_basic_user_file /etc/nginx/mail-admin.htpasswd;

        client_max_body_size 8k;
        limit_req zone=mail_admin burst=10 nodelay;

        proxy_pass http://127.0.0.1:4110/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Remote-User $remote_user;
        proxy_hide_header Server;
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    location /_next/static/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
